# ShadowCarrier: 稳定摄像头节点 (Microdia 0c45:6366)
# USB插拔会让 /dev/videoN 编号漂移 → 用 udev 规则建立固定符号链接
# 安装: cp 99-shadowcarrier-camera.rules /etc/udev/rules.d/ && udevadm control --reload-rules && udevadm trigger --subsystem-match=video4linux
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="6366", ATTR{index}=="0", SYMLINK+="camera0"
# 2026-10-14 [基建] 禁用相机 USB autosuspend: 之前 power/control=auto + autosuspend=2s 导致
#   相机周期性 suspend/resume 时 re-enumerate (dmesg: usb 7-1 disconnect/reconnect, 节点漂移),
#   旧 VideoCapture 持有已删节点 → 取流永久阻塞 → 整条检测管线死。设 control=on 保持常供电。
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0c45", ATTR{idProduct}=="6366", TEST=="power/control", ATTR{power/control}="on"

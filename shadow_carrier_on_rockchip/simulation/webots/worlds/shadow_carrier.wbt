#VRML_SIM R2025a utf8

# Demo 场景: 宿舍走廊 —— 宿舍门(左墙) → 走廊尽头饮水机 → 隔壁冰箱(右墙)
# 剧本: 跟出宿舍门 → 主人打水(静止) → 车躲到饮水机旁墙根(离门远) → 路人从宿舍门进来
#       → 主人到隔壁冰箱拿东西递给车 → 一起回宿舍

WorldInfo {
  basicTimeStep 8
  gravity 9.81
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "floor"
      coulombFriction 1.4
    }
    ContactProperties {
      material1 "caster"
      material2 "floor"
      coulombFriction 0.02
    }
  ]
}
Viewpoint {
  orientation 1 0 0 -0.75
  position 0 7.5 5.5
}
Background {
  skyColor [ 0.42 0.62 0.78 ]
}
DirectionalLight {
  direction -0.3 -1 -0.5
  intensity 0.9
}

# 走廊: x ∈ [-1.35, 1.35], z ∈ [-6, 6]; 主人从 +z 宿舍门走向 -z 尽头
DEF FLOOR Solid {
  translation 0 -0.06 0
  name "floor"
  contactMaterial "floor"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.78 0.81 0.79 roughness 0.92 }
      geometry Box { size 2.9 0.12 12.4 }
    }
  ]
  boundingObject Box { size 2.9 0.12 12.4 }
}

DEF LEFT_WALL Solid {
  translation -1.4 1.2 0
  name "left wall"
  children [ Shape { appearance PBRAppearance { baseColor 0.72 0.75 0.76 } geometry Box { size 0.1 2.4 12.4 } } ]
  boundingObject Box { size 0.1 2.4 12.4 }
}
DEF RIGHT_WALL Solid {
  translation 1.4 1.2 0
  name "right wall"
  children [ Shape { appearance PBRAppearance { baseColor 0.72 0.75 0.76 } geometry Box { size 0.1 2.4 12.4 } } ]
  boundingObject Box { size 0.1 2.4 12.4 }
}
DEF END_WALL Solid {
  translation 0 1.2 -6.05
  name "end wall"
  children [ Shape { appearance PBRAppearance { baseColor 0.72 0.75 0.76 } geometry Box { size 2.9 2.4 0.1 } } ]
  boundingObject Box { size 2.9 2.4 0.1 }
}
DEF NEAR_WALL Solid {
  translation 0 1.2 6.05
  name "near wall"
  children [ Shape { appearance PBRAppearance { baseColor 0.72 0.75 0.76 } geometry Box { size 2.9 2.4 0.1 } } ]
  boundingObject Box { size 2.9 2.4 0.1 }
}

# 宿舍门(左墙, z=+3): HIDE 网格的 "door" 地标, 路人从这里进走廊
DEF DORM_DOOR Solid {
  translation -1.3 0 3.0
  name "dorm door"
  model "door"
  recognitionColors [ 0.12 0.46 0.78 ]
  children [
    Pose {
      translation 0 0.95 -0.55
      children [ Shape { appearance PBRAppearance { baseColor 0.12 0.46 0.78 } geometry Box { size 0.10 1.9 0.10 } } ]
    }
    Pose {
      translation 0 0.95 0.55
      children [ Shape { appearance PBRAppearance { baseColor 0.12 0.46 0.78 } geometry Box { size 0.10 1.9 0.10 } } ]
    }
    Pose {
      translation 0 1.9 0
      children [ Shape { appearance PBRAppearance { baseColor 0.12 0.46 0.78 } geometry Box { size 0.10 0.08 1.20 } } ]
    }
  ]
}

# 隔壁门(右墙, z=-1.6): 视觉叙事"去隔壁拿东西", 网格里也算 door(远离冰箱角落)
DEF SIDE_DOOR Solid {
  translation 1.3 0 -1.6
  name "side door"
  model "door"
  recognitionColors [ 0.30 0.52 0.70 ]
  children [
    Pose {
      translation 0 0.95 -0.45
      children [ Shape { appearance PBRAppearance { baseColor 0.30 0.52 0.70 } geometry Box { size 0.10 1.9 0.10 } } ]
    }
    Pose {
      translation 0 0.95 0.45
      children [ Shape { appearance PBRAppearance { baseColor 0.30 0.52 0.70 } geometry Box { size 0.10 1.9 0.10 } } ]
    }
    Pose {
      translation 0 1.9 0
      children [ Shape { appearance PBRAppearance { baseColor 0.30 0.52 0.70 } geometry Box { size 0.10 0.08 1.00 } } ]
    }
  ]
}

# 长椅(左墙, z≈0): 走廊"路旁"的道具, 不在行车路径上
DEF BENCH Solid {
  translation -1.05 0.25 0.2
  name "bench"
  contactMaterial "obstacle"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.38 0.24 roughness 0.8 }
      geometry Box { size 0.35 0.5 1.2 }
    }
  ]
  boundingObject Box { size 0.35 0.5 1.2 }
}

# 饮水机(走廊尽头, 离宿舍门 ~9m)
DEF WATER_DISPENSER Solid {
  translation 0 0.55 -5.75
  name "water dispenser"
  model "water dispenser"
  recognitionColors [ 0.85 0.88 0.92 ]
  children [
    Shape { appearance PBRAppearance { baseColor 0.85 0.88 0.92 roughness 0.5 } geometry Box { size 0.45 1.10 0.42 } }
    Pose {
      translation 0 0.10 0.23
      children [ Shape { appearance PBRAppearance { baseColor 0.25 0.55 0.85 } geometry Box { size 0.10 0.18 0.06 } } ]
    }
  ]
  boundingObject Box { size 0.45 1.10 0.42 }
}

# 隔壁冰箱(左墙, 饮水机旁): 主人取物不离开车的视野, 回身递物触发 RECEIVE
DEF REFRIGERATOR Solid {
  translation -0.9 0.85 -4.8
  name "refrigerator"
  model "refrigerator"
  recognitionColors [ 0.90 0.91 0.93 ]
  children [
    Shape { appearance PBRAppearance { baseColor 0.90 0.91 0.93 roughness 0.45 } geometry Box { size 0.60 1.70 0.60 } }
    Pose {
      translation -0.31 0.10 0
      children [ Shape { appearance PBRAppearance { baseColor 0.30 0.33 0.36 } geometry Box { size 0.05 0.90 0.10 } } ]
    }
  ]
  boundingObject Box { size 0.60 1.70 0.60 }
}

DEF OWNER Solid {
  translation -0.8 0 3.0
  name "simulated owner"
  model "person"
  recognitionColors [ 0.82 0.20 0.16 ]
  children [
    Pose {
      translation 0 0.92 0
      children [ Shape { appearance PBRAppearance { baseColor 0.82 0.20 0.16 roughness 0.7 } geometry Box { size 0.48 0.78 0.30 } } ]
    }
    Pose {
      translation 0 1.48 0
      children [ Shape { appearance PBRAppearance { baseColor 0.88 0.67 0.48 roughness 0.8 } geometry Sphere { radius 0.16 } } ]
    }
    Pose {
      translation -0.14 0.30 0
      children [ Shape { appearance PBRAppearance { baseColor 0.17 0.22 0.30 } geometry Box { size 0.17 0.60 0.22 } } ]
    }
    Pose {
      translation 0.14 0.30 0
      children [ Shape { appearance PBRAppearance { baseColor 0.17 0.22 0.30 } geometry Box { size 0.17 0.60 0.22 } } ]
    }
    Pose {
      translation -0.31 0.91 0
      rotation 0 0 1 -0.15
      children [ Shape { appearance PBRAppearance { baseColor 0.88 0.67 0.48 } geometry Box { size 0.13 0.64 0.14 } } ]
    }
    Pose {
      translation 0.31 0.91 0
      rotation 0 0 1 0.15
      children [ Shape { appearance PBRAppearance { baseColor 0.88 0.67 0.48 } geometry Box { size 0.13 0.64 0.14 } } ]
    }
  ]
  boundingObject Pose {
    translation 0 0.83 0
    children [ Box { size 0.62 1.66 0.38 } ]
  }
}

# 双人场景路人: 默认停在远处不可见, 剧本/键盘从宿舍门带入

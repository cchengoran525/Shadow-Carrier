#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 32
  gravity 9.81
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "floor"
      coulombFriction 1.4
    }
  ]
}
Viewpoint {
  orientation 1 0 0 -0.62
  position 0 4.8 6
}
Background {
  skyColor [ 0.42 0.62 0.78 ]
}
DirectionalLight {
  direction -0.3 -1 -0.5
  intensity 0.9
}

DEF FLOOR Solid {
  translation 0 -0.06 0
  name "floor"
  contactMaterial "floor"

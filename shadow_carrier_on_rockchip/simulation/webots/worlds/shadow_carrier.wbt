DEF SIM_ROBOT Robot {
  translation 0 0.06 0
  name "Shadow Carrier simulation"
  controller "shadow_carrier"
  supervisor TRUE
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.12 0.20 0.24 roughness 0.58 }
      geometry Box { size 0.22 0.075 0.27 }
    }
    Pose {
      translation 0 0.04 -0.15
      children [ Shape { appearance PBRAppearance { baseColor 0.95 0.82 0.22 } geometry Box { size 0.12 0.025 0.015 } } ]
    }
    HingeJoint {
      jointParameters HingeJointParameters { anchor -0.115 -0.015 0 axis 1 0 0 }
      device [ RotationalMotor { name "left wheel motor" maxTorque 4 maxVelocity 18 } ]
      endPoint Solid {
        name "left wheel"
        contactMaterial "wheel"
        children [
          Transform {
            rotation 0 0 1 1.5708
            children [ Shape { appearance PBRAppearance { baseColor 0.08 0.09 0.10 roughness 0.96 } geometry Cylinder { radius 0.047 height 0.028 } } ]
          }
        ]
        boundingObject Pose { rotation 0 0 1 1.5708 children [ Cylinder { radius 0.047 height 0.028 } ] }
        physics Physics { density -1 mass 0.09 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { anchor 0.115 -0.015 0 axis 1 0 0 }
      device [ RotationalMotor { name "right wheel motor" maxTorque 4 maxVelocity 18 } ]
      endPoint Solid {
        name "right wheel"
        contactMaterial "wheel"
        children [
          Transform {
            rotation 0 0 1 1.5708
            children [ Shape { appearance PBRAppearance { baseColor 0.08 0.09 0.10 roughness 0.96 } geometry Cylinder { radius 0.047 height 0.028 } } ]
          }
        ]
        boundingObject Pose { rotation 0 0 1 1.5708 children [ Cylinder { radius 0.047 height 0.028 } ] }
        physics Physics { density -1 mass 0.09 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { anchor 0 0.095 -0.045 axis 0 1 0 }
      device [ RotationalMotor { name "pan motor" minPosition -1.5708 maxPosition 1.5708 maxVelocity 2.5 maxTorque 0.4 } ]
      endPoint Solid {
        name "pan stage"
        children [
          Shape { appearance PBRAppearance { baseColor 0.25 0.31 0.33 } geometry Box { size 0.08 0.035 0.08 } }
          HingeJoint {
            jointParameters HingeJointParameters { anchor 0 0.025 -0.02 axis 1 0 0 }
            device [ RotationalMotor { name "tilt motor" minPosition -1.95 maxPosition 1.19 maxVelocity 2.5 maxTorque 0.4 } ]
            endPoint Solid {
              name "tilt stage"
              children [
                Shape { appearance PBRAppearance { baseColor 0.16 0.25 0.29 } geometry Box { size 0.095 0.055 0.08 } }
                Camera {
                  name "front camera"
                  translation 0 0.005 -0.055
                  width 640
                  height 480
                  fieldOfView 1.0
                  near 0.03
                  far 8
                  recognition Recognition { }
                }
              ]
              boundingObject Box { size 0.10 0.06 0.09 }
              physics Physics { density -1 mass 0.05 }
            }
          }
        ]
        boundingObject Box { size 0.09 0.04 0.09 }
        physics Physics { density -1 mass 0.05 }
      }
    }
    DistanceSensor {
      name "front sonar"
      translation 0 0.035 -0.145
      rotation 0 1 0 1.5708
      type "sonar"
      numberOfRays 5
      aperture 0.35
      lookupTable [ 0 0 0, 0.2 20 0, 2 200 0 ]
    }
  ]
  boundingObject Box { size 0.22 0.075 0.27 }
  physics Physics { density -1 mass 0.85 centerOfMass [ 0 0.015 0 ] }
}
